+	Inc., 51 Franklin Street, Fifth Floor, Boston, MA 02110-1301 USA.
+*/
+
+/* sd-varlink-idl.h needs __VA_OPT__ */
+#define _GNU_SOURCE
+
+#include <config.h>
+
+#include <errno.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/epoll.h>
+#include <sys/eventfd.h>
+#include <unistd.h>
+
+#include <systemd/sd-event.h>
+#include <systemd/sd-json.h>
+#include <systemd/sd-varlink.h>
+#include <systemd/sd-varlink-idl.h>
+
+#include <pcsclite.h>
+#include <ifdhandler.h>
+#include <reader.h>
+
+#include "misc.h"
+#include "ccid.h"
+#include "defs.h"
+#include "ccid_ifdhandler.h"
+#include "debug.h"
+#include "touch.h"
+
+/*
+ * The driver's threads (one per reader) only update the table below and poke
+ * an eventfd. A thread of our own runs the Varlink server, which is not
+ * thread safe: it compares the table against what it last sent and tells
+ * every watcher about the differences. A wait that starts and ends between
+ * two wakeups is never reported, which is fine: nobody needed to be told.
+ */
+
+static SD_VARLINK_DEFINE_METHOD_FULL(
+		Watch,
+		SD_VARLINK_SUPPORTS_MORE,
+		SD_VARLINK_FIELD_COMMENT("The reader's device, as pcscd named it, e.g. usb:1050/0406:libudev:0:/dev/bus/usb/001/002"),
+		SD_VARLINK_DEFINE_OUTPUT(device, SD_VARLINK_STRING, 0),
+		SD_VARLINK_FIELD_COMMENT("Whether the card is still working on a command, which for a security key means waiting for a touch"),
+		SD_VARLINK_DEFINE_OUTPUT(waiting, SD_VARLINK_BOOL, 0));
+
+static SD_VARLINK_DEFINE_INTERFACE(
+		io_github_philiptaron_CcidTouch,
+		"io.github.philiptaron.CcidTouch",
+		SD_VARLINK_INTERFACE_COMMENT("Readers whose card is waiting, e.g. for a touch, as seen by the CCID driver"),
+		SD_VARLINK_SYMBOL_COMMENT("Report every reader waiting now, then every change. Must be called with the 'more' flag."),
+		&vl_method_Watch);
+
+struct touch_reader
+{
+	int reader_index;
+	char *device;
+	bool waiting;	/* as last reported by the driver */
+	bool sent;	/* as last sent to the watchers */
+	bool closed;
+};
+
+/* shared with the driver's threads */
+static pthread_mutex_t touch_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct touch_reader *touch_readers;
+static size_t touch_readers_count;
+static int touch_eventfd = -1;
+
+/* only used by the Varlink thread */
+static sd_varlink **touch_watchers;
+static size_t touch_watchers_count;
+
+static pthread_once_t touch_once = PTHREAD_ONCE_INIT;
+
+/* called with touch_mutex held */
+static struct touch_reader *touch_find(const CcidDesc *ccid_reader, bool add)
+{
+	struct touch_reader *readers;
+
+	for (size_t i = 0; i < touch_readers_count; i++)
+	{
+		if (touch_readers[i].reader_index == ccid_reader->reader_index
+			&& !touch_readers[i].closed)
+			return &touch_readers[i];
+	}
+
+	if (!add)
+		return NULL;
+
+	readers = realloc(touch_readers,
+		(touch_readers_count + 1) * sizeof(*touch_readers));
+	if (NULL == readers)
+		return NULL;
+	touch_readers = readers;
+
+	readers = &touch_readers[touch_readers_count];
+	readers->device = strdup(ccid_reader->readerName ? ccid_reader->readerName : "");
+	if (NULL == readers->device)
+		return NULL;
+	readers->reader_index = ccid_reader->reader_index;
+	readers->waiting = false;
+	readers->sent = false;
+	readers->closed = false;
+	touch_readers_count++;
+
+	return readers;
+}
+
+/* called with touch_mutex held */
+static void touch_poke(void)
+{
+	if (touch_eventfd >= 0)
+		(void)eventfd_write(touch_eventfd, 1);
+}
+
+static void touch_notify(sd_varlink *link, const struct touch_reader *reader)
+{
+	int r;
+
+	r = sd_varlink_notifybo(link,
+		SD_JSON_BUILD_PAIR_STRING("device", reader->device),
+		SD_JSON_BUILD_PAIR_BOOLEAN("waiting", reader->sent));
+	if (r < 0)
+		DEBUG_INFO2("Cannot notify a touch watcher: %s", strerror(-r));
+}
+
+/* send every change since the last flush to every watcher */
+static void touch_flush(void)
+{
+	size_t kept = 0;
+
+	(void)pthread_mutex_lock(&touch_mutex);
+	for (size_t i = 0; i < touch_readers_count; i++)
+	{
+		struct touch_reader *reader = &touch_readers[i];
+
+		if (reader->waiting != reader->sent)
+		{
+			reader->sent = reader->waiting;
+			for (size_t j = 0; j < touch_watchers_count; j++)
+				touch_notify(touch_watchers[j], reader);
+		}
+
+		if (reader->closed)
+			free(reader->device);
+		else
+			touch_readers[kept++] = *reader;
+	}
+	touch_readers_count = kept;
+	(void)pthread_mutex_unlock(&touch_mutex);
+}
+
+static int touch_on_eventfd(sd_event_source *source, int fd, uint32_t revents,
+	void *userdata)
+{
+	eventfd_t value;
+
+	(void)source;
+	(void)revents;
+	(void)userdata;
+
+	(void)eventfd_read(fd, &value);
+	touch_flush();
+
+	return 0;
+}
+
+static int touch_watch(sd_varlink *link, sd_json_variant *parameters,
+	sd_varlink_method_flags_t flags, void *userdata)
+{
+	sd_varlink **watchers;
+
+	(void)parameters;
+	(void)userdata;
+
+	if (!(flags & SD_VARLINK_METHOD_MORE))
+		return sd_varlink_error(link, SD_VARLINK_ERROR_EXPECTED_MORE, NULL);
+
+	watchers = realloc(touch_watchers,
+		(touch_watchers_count + 1) * sizeof(*touch_watchers));
+	if (NULL == watchers)
+		return -ENOMEM;
+	touch_watchers = watchers;
+	touch_watchers[touch_watchers_count++] = sd_varlink_ref(link);
+
+	/* the readers already waiting; the others are reported as they change */
+	(void)pthread_mutex_lock(&touch_mutex);
+	for (size_t i = 0; i < touch_readers_count; i++)
+	{
+		if (touch_readers[i].sent)
+			touch_notify(link, &touch_readers[i]);
+	}
+	(void)pthread_mutex_unlock(&touch_mutex);
+
+	return 0;
+}
+
+static void touch_disconnect(sd_varlink_server *server, sd_varlink *link,
+	void *userdata)
+{
+	(void)server;
+	(void)userdata;
+
+	for (size_t i = 0; i < touch_watchers_count; i++)
+	{
+		if (touch_watchers[i] == link)
+		{
+			sd_varlink_unref(link);
+			touch_watchers[i] = touch_watchers[--touch_watchers_count];
+			return;
+		}
+	}
+}
+
+static void *touch_thread(void *arg)
+{
+	sd_event *event = NULL;
+	sd_varlink_server *server = NULL;
+	int fd = (int)(intptr_t)arg;
+	int r;
+
+	r = sd_event_new(&event);
+	if (r < 0)
+		goto end;
+
+	r = sd_event_add_io(event, NULL, fd, EPOLLIN, touch_on_eventfd, NULL);
+	if (r < 0)
+		goto end;
+
+	r = sd_varlink_server_new(&server, 0);
+	if (r < 0)
+		goto end;
+
+	r = sd_varlink_server_set_info(server, "CCID", "libccid", VERSION,
+		"https://ccid.apdu.fr/");
+	if (r < 0)
+		goto end;
+
+	r = sd_varlink_server_add_interface(server,
+		&vl_interface_io_github_philiptaron_CcidTouch);
+	if (r < 0)
+		goto end;
+
+	r = sd_varlink_server_bind_method(server,
+		"io.github.philiptaron.CcidTouch.Watch", touch_watch);
+	if (r < 0)
+		goto end;
+
+	r = sd_varlink_server_bind_disconnect(server, touch_disconnect);
+	if (r < 0)
+		goto end;
+
+	r = sd_varlink_server_listen_address(server, CCID_VARLINK_ADDRESS, 0666);
+	if (r < 0)
+		goto end;
+
+	r = sd_varlink_server_attach_event(server, event, SD_EVENT_PRIORITY_NORMAL);
+	if (r < 0)
+		goto end;
+
+	DEBUG_INFO2("Reporting touch requests on %s", CCID_VARLINK_ADDRESS);
+	r = sd_event_loop(event);
+
+end:
+	if (r < 0)
+		DEBUG_CRITICAL3("Cannot report touch requests on %s: %s",
+			CCID_VARLINK_ADDRESS, strerror(-r));
+
+	(void)pthread_mutex_lock(&touch_mutex);
+	touch_eventfd = -1;
+	(void)pthread_mutex_unlock(&touch_mutex);
+
+	sd_varlink_server_unref(server);
+	sd_event_unref(event);
+	(void)close(fd);
+
+	return NULL;
+}
+
+static void touch_start(void)
+{
+	pthread_t thread;
+	pthread_attr_t attr;
+	int fd;
+
+	fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+	if (fd < 0)
+	{
+		DEBUG_CRITICAL2("Cannot create an eventfd: %s", strerror(errno));
+		return;
+	}
+
+	(void)pthread_attr_init(&attr);
+	(void)pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+
+	(void)pthread_mutex_lock(&touch_mutex);
+	touch_eventfd = fd;
+	(void)pthread_mutex_unlock(&touch_mutex);
+
+	if (pthread_create(&thread, &attr, touch_thread, (void *)(intptr_t)fd))
+	{
+		DEBUG_CRITICAL("Cannot start the touch reporting thread");
+		(void)pthread_mutex_lock(&touch_mutex);
+		touch_eventfd = -1;
+		(void)pthread_mutex_unlock(&touch_mutex);
+		(void)close(fd);
+	}
+
+	(void)pthread_attr_destroy(&attr);
+}
+
+void TouchInit(void)
+{
+	(void)pthread_once(&touch_once, touch_start);
+}
+
+void TouchWaiting(const CcidDesc *ccid_reader, bool waiting)
+{
+	struct touch_reader *reader;
+
+	(void)pthread_mutex_lock(&touch_mutex);
+	if (touch_eventfd >= 0)
+	{
+		reader = touch_find(ccid_reader, waiting);
+		if (reader && reader->waiting != waiting)
+		{
+			reader->waiting = waiting;
+			touch_poke();
+		}
+	}
+	(void)pthread_mutex_unlock(&touch_mutex);
+}
+
+void TouchClose(const CcidDesc *ccid_reader)
+{
+	struct touch_reader *reader;
+
+	(void)pthread_mutex_lock(&touch_mutex);
+	reader = touch_find(ccid_reader, false);
+	if (reader)
+	{
+		reader->waiting = false;
+		reader->closed = true;
+		touch_poke();
+	}
+	(void)pthread_mutex_unlock(&touch_mutex);
+}
