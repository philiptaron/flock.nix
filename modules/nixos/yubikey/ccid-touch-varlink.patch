--- a/src/commands.c
+++ b/src/commands.c
@@ -38,6 +38,7 @@
 #include "ccid_ifdhandler.h"
 #include "debug.h"
 #include "utils.h"
+#include "touch.h"
 
 /* All the pinpad readers I used are more or less bogus
  * I use code to change the user command and make the firmware happy */
@@ -972,6 +973,7 @@ RESPONSECODE CmdEscapeCheck(CcidDesc * ccid_reader,
 	unsigned int length_in, length_out, length_out_read;
 	RESPONSECODE return_value = IFD_SUCCESS;
 	int old_read_timeout = -1;
+	bool waiting = false;
 	_ccid_descriptor *ccid_descriptor = &ccid_reader->device.ccid;
 
 	/* a value of 0 do not change the default read timeout */
@@ -1056,6 +1058,11 @@ time_request:
 	if (cmd_out[STATUS_OFFSET] & CCID_TIME_EXTENSION)
 	{
 		DEBUG_COMM2("Time extension requested: 0x%02X", cmd_out[ERROR_OFFSET]);
+
+		/* the card may be waiting for a touch */
+		waiting = true;
+		TouchWaiting(ccid_reader, true);
+
 		goto time_request;
 	}
 
@@ -1091,6 +1098,10 @@ end:
 	if (timeout > 0)
 		ccid_descriptor -> readTimeout = old_read_timeout;
 
+	/* the card answered, or the reader is gone */
+	if (waiting)
+		TouchWaiting(ccid_reader, false);
+
 	return return_value;
 } /* EscapeCheck */
 
@@ -1450,8 +1461,29 @@ RESPONSECODE CCID_Transmit(CcidDesc * ccid_reader, unsigned int tx_length,
  *					CCID_Receive
  *
  ****************************************************************************/
+static RESPONSECODE CCID_ReceiveFrame(CcidDesc * ccid_reader,
+	unsigned int *rx_length, unsigned char rx_buffer[],
+	unsigned char *chain_parameter, bool *waiting);
+
 RESPONSECODE CCID_Receive(CcidDesc * ccid_reader, unsigned int *rx_length,
 	unsigned char rx_buffer[], unsigned char *chain_parameter)
+{
+	RESPONSECODE return_value;
+	bool waiting = false;
+
+	return_value = CCID_ReceiveFrame(ccid_reader, rx_length, rx_buffer,
+		chain_parameter, &waiting);
+
+	/* the card answered, or the reader is gone */
+	if (waiting)
+		TouchWaiting(ccid_reader, false);
+
+	return return_value;
+} /* CCID_Receive */
+
+static RESPONSECODE CCID_ReceiveFrame(CcidDesc * ccid_reader,
+	unsigned int *rx_length, unsigned char rx_buffer[],
+	unsigned char *chain_parameter, bool *waiting)
 {
 	unsigned char cmd[CCID_HEADER_SIZE + CMD_BUF_SIZE];	/* CCID + APDU buffer */
 	unsigned int length;
@@ -1641,6 +1673,10 @@ time_request:
 	{
 		DEBUG_COMM2("Time extension requested: 0x%02X", cmd[ERROR_OFFSET]);
 
+		/* the card may be waiting for a touch */
+		*waiting = true;
+		TouchWaiting(ccid_reader, true);
+
 		/* compute the new value of read timeout */
 		if (cmd[ERROR_OFFSET] > 0)
 			ccid_descriptor -> readTimeout *= cmd[ERROR_OFFSET];
@@ -1683,7 +1719,7 @@ time_request:
 		*chain_parameter = cmd[CHAIN_PARAMETER_OFFSET];
 
 	return return_value;
-} /* CCID_Receive */
+} /* CCID_ReceiveFrame */
 
 
