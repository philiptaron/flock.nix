+#ifndef __TOUCH_H__
+#define __TOUCH_H__
+
+#include <stdbool.h>
+
+/*
+ * A card that needs more time sends CCID time extensions until it answers.
+ * Security keys do this while they wait for a touch, so a reader that is
+ * receiving time extensions is reported as "waiting" to every client of the
+ * Varlink interface io.github.philiptaron.CcidTouch, until the card answers or
+ * the reader goes away.
+ */
+#if defined(HAVE_VARLINK) && !defined(TWIN_SERIAL)
+void TouchInit(void);
+void TouchWaiting(const CcidDesc *ccid_reader, bool waiting);
+void TouchClose(const CcidDesc *ccid_reader);
+#else
+static inline void TouchInit(void) {}
+static inline void TouchWaiting(const CcidDesc *ccid_reader, bool waiting)
+{
+	(void)ccid_reader;
+	(void)waiting;
+}
+static inline void TouchClose(const CcidDesc *ccid_reader)
+{
+	(void)ccid_reader;
+}
+#endif
+
+#endif
