diff --git a/detector/piv_linux.go b/detector/piv_linux.go
new file mode 100644
index 0000000000000..1ef5c114ecfd9
--- /dev/null
+++ b/detector/piv_linux.go
@@ -0,0 +1,143 @@
+package detector
+
+import (
+	"bufio"
+	"encoding/json"
+	"errors"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/rjeczalik/notify"
+	log "github.com/sirupsen/logrus"
+
+	"github.com/maximbaz/yubikey-touch-detector/notifier"
+)
+
+const (
+	// The Varlink socket served by libccid, the CCID driver of pcscd, when it is built with
+	// its `varlink` option. Override it with YUBIKEY_TOUCH_DETECTOR_CCID_SOCKET.
+	CCID_TOUCH_SOCKET = "/run/pcscd/ccid-touch"
+	CCID_TOUCH_WATCH  = "io.github.philiptaron.CcidTouch.Watch"
+
+	// pcscd names USB readers "usb:<vendor>/<product>:...", and Yubico's vendor ID is 1050.
+	YUBICO_READER_PREFIX = "usb:1050/"
+)
+
+type ccidTouchReply struct {
+	Parameters struct {
+		Device  string `json:"device"`
+		Waiting bool   `json:"waiting"`
+	} `json:"parameters"`
+	Continues bool   `json:"continues"`
+	Error     string `json:"error"`
+}
+
+// WatchPIV watches when YubiKey is waiting for a touch on a PIV or OpenPGP request made through
+// pcscd. A card that needs more time answers with CCID time extensions, which only pcscd sees;
+// libccid reports them over Varlink as long as they last.
+func WatchPIV(notifiers *sync.Map) {
+	socketPath := CCID_TOUCH_SOCKET
+	if value, found := os.LookupEnv("YUBIKEY_TOUCH_DETECTOR_CCID_SOCKET"); found {
+		socketPath = filepath.Clean(value)
+	}
+
+	// pcscd exits when idle, and its driver binds the socket again when pcscd starts, so wait
+	// for the socket to be created instead of polling it.
+	socketEvents := initInotifyWatcher("PIV", filepath.Dir(socketPath), notify.Create)
+	defer notify.Stop(socketEvents)
+
+	publish := func(message notifier.Message) {
+		notifiers.Range(func(_, value interface{}) bool {
+			value.(chan notifier.Message) <- message
+			return true
+		})
+	}
+
+	for {
+		err := watchCCIDTouch(socketPath, publish)
+		log.Debugf("PIV watcher on '%v' is not connected: %v", socketPath, err)
+		waitForSocket(socketPath, socketEvents)
+	}
+}
+
+// watchCCIDTouch follows the Varlink stream until it ends, publishing PIV_ON while any YubiKey
+// reader is waiting and PIV_OFF once none is.
+func watchCCIDTouch(socketPath string, publish func(notifier.Message)) error {
+	conn, err := net.Dial("unix", socketPath)
+	if err != nil {
+		return err
+	}
+	defer conn.Close()
+
+	call := `{"method":"` + CCID_TOUCH_WATCH + `","more":true}` + "\x00"
+	if _, err := conn.Write([]byte(call)); err != nil {
+		return err
+	}
+	log.Debugf("PIV watcher on '%v' is successfully established", socketPath)
+
+	waiting := make(map[string]bool)
+	defer func() {
+		if len(waiting) > 0 {
+			publish(notifier.PIV_OFF)
+		}
+	}()
+
+	reader := bufio.NewReader(conn)
+	for {
+		frame, err := reader.ReadBytes(0)
+		if err != nil {
+			return err
+		}
+
+		var reply ccidTouchReply
+		if err := json.Unmarshal(frame[:len(frame)-1], &reply); err != nil {
+			return err
+		}
+		if reply.Error != "" {
+			return errors.New(reply.Error)
+		}
+
+		device := reply.Parameters.Device
+		if strings.HasPrefix(device, YUBICO_READER_PREFIX) {
+			wasActive := len(waiting) > 0
+			if reply.Parameters.Waiting {
+				waiting[device] = true
+			} else {
+				delete(waiting, device)
+			}
+			if isActive := len(waiting) > 0; isActive != wasActive {
+				if isActive {
+					publish(notifier.PIV_ON)
+				} else {
+					publish(notifier.PIV_OFF)
+				}
+			}
+		}
+
+		if !reply.Continues {
+			return errors.New("the call ended")
+		}
+	}
+}
+
+func waitForSocket(socketPath string, events chan notify.EventInfo) {
+	// The socket of a pcscd that exited stays behind, and the directory may not have existed
+	// when the watch was set up, so also retry now and then.
+	timeout := time.After(30 * time.Second)
+	for {
+		select {
+		case event := <-events:
+			if event.Path() == socketPath {
+				// Give the server time to get from bind() to listen().
+				time.Sleep(100 * time.Millisecond)
+				return
+			}
+		case <-timeout:
+			return
+		}
+	}
+}
diff --git a/detector/piv_linux_test.go b/detector/piv_linux_test.go
new file mode 100644
index 0000000000000..a969ca17c4ecc
--- /dev/null
+++ b/detector/piv_linux_test.go
@@ -0,0 +1,89 @@
+package detector
+
+import (
+	"bufio"
+	"net"
+	"path/filepath"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/maximbaz/yubikey-touch-detector/notifier"
+)
+
+func TestWatchCCIDTouchTracksYubiKeyReaders(t *testing.T) {
+	socketPath := filepath.Join(t.TempDir(), "ccid-touch")
+	listener, err := net.Listen("unix", socketPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+
+	yubikey := "usb:1050/0406:libudev:1:/dev/bus/usb/001/002"
+	other := "usb:20a0/42b2:libudev:0:/dev/bus/usb/001/003"
+	replies := []string{
+		`{"parameters":{"device":"` + other + `","waiting":true},"continues":true}`,
+		`{"parameters":{"device":"` + yubikey + `","waiting":true},"continues":true}`,
+		`{"parameters":{"device":"` + other + `","waiting":false},"continues":true}`,
+		`{"parameters":{"device":"` + yubikey + `","waiting":false},"continues":true}`,
+		`{"parameters":{"device":"` + yubikey + `","waiting":true},"continues":true}`,
+	}
+
+	calls := make(chan string, 1)
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		call, _ := bufio.NewReader(conn).ReadString(0)
+		calls <- call
+		for _, reply := range replies {
+			conn.Write([]byte(reply + "\x00"))
+		}
+	}()
+
+	var messages []notifier.Message
+	err = watchCCIDTouch(socketPath, func(message notifier.Message) {
+		messages = append(messages, message)
+	})
+	if err == nil {
+		t.Fatal("watchCCIDTouch returned no error when the connection closed")
+	}
+
+	if call := <-calls; !strings.Contains(call, `"method":"`+CCID_TOUCH_WATCH+`"`) || !strings.Contains(call, `"more":true`) {
+		t.Fatalf("call = %q, want a Watch call with more", call)
+	}
+
+	// The last wait is cut short by the connection closing.
+	want := []notifier.Message{notifier.PIV_ON, notifier.PIV_OFF, notifier.PIV_ON, notifier.PIV_OFF}
+	if !reflect.DeepEqual(messages, want) {
+		t.Fatalf("messages = %v, want %v", messages, want)
+	}
+}
+
+func TestWatchCCIDTouchStopsOnError(t *testing.T) {
+	socketPath := filepath.Join(t.TempDir(), "ccid-touch")
+	listener, err := net.Listen("unix", socketPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+
+	go func() {
+		conn, err := listener.Accept()
+		if err != nil {
+			return
+		}
+		defer conn.Close()
+		bufio.NewReader(conn).ReadString(0)
+		conn.Write([]byte(`{"error":"org.varlink.service.MethodNotFound","parameters":{"method":"` + CCID_TOUCH_WATCH + `"}}` + "\x00"))
+	}()
+
+	err = watchCCIDTouch(socketPath, func(message notifier.Message) {
+		t.Fatalf("unexpected message %v", message)
+	})
+	if err == nil || err.Error() != "org.varlink.service.MethodNotFound" {
+		t.Fatalf("err = %v, want org.varlink.service.MethodNotFound", err)
+	}
+}
