# Philip Taron's bashrc
#
# This is processed through pkgs.replaceVars in ../default.nix.

# Make bash history not forget things so often.
HISTSIZE=10000000
HISTFILESIZE=100000000

# Set up `h` to use my personal Git credentials. Clones borrow objects from the personal store.
# The roots, stores and credentials of `h` and `hq` come from ../../h/identities.nix.
eval "$(@h@/bin/h-shell-init --pushd --name h --store @hStore@ --git-opts @hGitOpts@ @hRoot@)"

# Set up `hq` to use the work-flavored version of my credentials, with its own store.
eval "$(@h@/bin/h-shell-init --pushd --name hq --store @hqStore@ --git-opts @hqGitOpts@ @hqRoot@)"

# Set up `up` to go up with `pushd`
eval "$(@h@/bin/up-shell-init --pushd)"

# Run Claude Code without permission prompts.
alias dangerclaude='claude --dangerously-skip-permissions'
