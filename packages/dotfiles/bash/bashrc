# Philip Taron's bashrc
#
# This is processed through pkgs.replaceVars in ../default.nix.

# Make bash history not forget things so often.
HISTSIZE=10000000
HISTFILESIZE=100000000

# The `h` and `hq` functions come from modules/nixos/h.nix, with the identities the host gives.

# Set up `up` to go up with `pushd`
eval "$(@h@/bin/up-shell-init --pushd)"

# Run Claude Code without permission prompts.
alias dangerclaude='claude --dangerously-skip-permissions'
